# Mangopi CLI Windows offline profile for NewAPI/OpenAI-compatible gateways.
#
# Copy this file to config.env in the same directory, then edit the values below.
# PowerShell scripts in this package load KEY=VALUE lines from config.env.

MANGO_API_URL=http://127.0.0.1:3000/v1
MANGO_MODEL=qwen3-32b
MANGO_KEY=replace-with-newapi-token

# 16k context profile. The agent starts compacting around 80% of this value.
MANGO_MAX_CONTEXT=16000
MANGO_MAX_OUTPUT=2048
MANGO_MAX_ITER=30

# Conservative generation settings for tool use.
MANGO_TEMPERATURE=0.1
MANGO_TOP_P=0.8
MANGO_TOOL_CHOICE=auto

# Offline/private-network defaults.
MANGO_OFFLINE=1
MANGO_DISABLE_TOOLS=web_search,view_image
MANGO_LANG=zh

# Limit tool output so a 16k model does not lose the working context.
MANGO_READ_DEFAULT_LIMIT=220
MANGO_GREP_MAX_HITS=120
MANGO_BASH_MAX_LINES=220

# API timeout/retry behavior for slower private deployments.
MANGO_REQUEST_TIMEOUT=300
MANGO_REQUEST_RETRIES=2
